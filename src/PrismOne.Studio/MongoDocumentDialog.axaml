<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrismOne.Studio.MongoDocumentDialog"
        Icon="/Assets/icon.png"
        Title="Edit Document"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <!-- Studio3T 의 Edit Document 대응 — 문서 전체를 JSON 으로 고쳐 _id 기준으로 되쓴다 -->
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" Name="HeaderText" FontSize="12" Opacity="0.7"
               Margin="0,0,0,8" TextWrapping="Wrap"/>
    <TextBlock DockPanel.Dock="Bottom" Name="ErrorText" Foreground="#C8102E" FontSize="12"
               Margin="0,8,0,0" TextWrapping="Wrap" IsVisible="False"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,10,0,0">
      <Button Content="Cancel" MinHeight="30" Click="OnCancel" IsCancel="True"/>
      <Button Content="Save" MinHeight="30" Classes="accent" Click="OnSave"/>
    </StackPanel>
    <TextBox Name="JsonBox" AcceptsReturn="True" AcceptsTab="True"
             TextWrapping="NoWrap"
             FontFamily="Menlo, Consolas, Monaco, Courier New" FontSize="12.5"
             VerticalContentAlignment="Top"/>
  </DockPanel>
</Window>
