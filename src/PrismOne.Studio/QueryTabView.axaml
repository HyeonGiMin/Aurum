<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="PrismOne.Studio.QueryTabView">
  <!-- Golden 쿼리 창: 위 SQL 에디터(키워드 하이라이팅), 아래 결과 그리드 -->
  <Grid RowDefinitions="*,4,1.6*,Auto" Background="{DynamicResource ContentBgBrush}">

    <ae:TextEditor Name="Editor" Grid.Row="0"
                   Background="{DynamicResource ContentBgBrush}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontFamily="{OnPlatform 'Consolas', macOS='Menlo', Linux='DejaVu Sans Mono'}"
                   FontSize="13"
                   ShowLineNumbers="False"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   Padding="8,6"/>

    <GridSplitter Grid.Row="1" Background="{DynamicResource ChromeBorderBrush}" ResizeDirection="Rows"/>

    <Grid Grid.Row="2" RowDefinitions="Auto,*">

    <!-- Golden EditMode 상단 바 (DBNavigator) — Run and Edit(Ctrl+E) 중에만 보인다 -->
    <Border Grid.Row="0" Name="EditBar" IsVisible="False" Padding="6,3"
            Background="{DynamicResource ChromeBgBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" Click="OnEditNavFirst" ToolTip.Tip="First record">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="M13,5 L6,12 L13,19 M20,5 L13,12 L20,19" Stroke="{DynamicResource FloppyBlueBrush}"
                  StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"/>
          </Canvas></Viewbox>
        </Button>
        <Button Classes="tool" Click="OnEditNavPrev" ToolTip.Tip="Prior record">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource FloppyBlueBrush}"
                  StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"/>
          </Canvas></Viewbox>
        </Button>
        <Button Classes="tool" Click="OnEditNavNext" ToolTip.Tip="Next record">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource FloppyBlueBrush}"
                  StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"/>
          </Canvas></Viewbox>
        </Button>
        <Button Classes="tool" Click="OnEditNavLast" ToolTip.Tip="Last record">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="M4,5 L11,12 L4,19 M11,5 L18,12 L11,19" Stroke="{DynamicResource FloppyBlueBrush}"
                  StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round"/>
          </Canvas></Viewbox>
        </Button>

        <Border Width="1" Height="16" Background="{DynamicResource SeparatorBrush}" Margin="6,0"/>

        <Button Classes="tool" Click="OnEditAddRow" ToolTip.Tip="Insert record — 새 행 추가 (Submit 때 INSERT)">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="M9.7,4 L14.3,4 L14.3,9.7 L20,9.7 L20,14.3 L14.3,14.3 L14.3,20 L9.7,20 L9.7,14.3 L4,14.3 L4,9.7 L9.7,9.7 Z"
                  Fill="{DynamicResource ExportGreenBrush}"/>
          </Canvas></Viewbox>
        </Button>
        <Button Classes="tool" Click="OnEditPasteRows" ToolTip.Tip="Paste records — 클립보드(탭 구분/엑셀) 행 삽입">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="{StaticResource IconPasteBoard}" Fill="{StaticResource PasteTanBrush}" Stroke="#8A6D3B" StrokeThickness="1"/>
            <Path Data="{StaticResource IconPasteClip}" Fill="{DynamicResource IconGrayBrush}"/>
            <Path Data="{StaticResource IconPastePaper}" Fill="White"/>
          </Canvas></Viewbox>
        </Button>

        <Border Width="1" Height="16" Background="{DynamicResource SeparatorBrush}" Margin="6,0"/>

        <Button Classes="tool" Click="OnEditDeleteRows" ToolTip.Tip="Delete record(s) — 선택 행 삭제 표시 (Submit 때 DELETE)">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="M4,9.7 L20,9.7 L20,14.3 L4,14.3 Z" Fill="{DynamicResource CancelRedBrush}"/>
          </Canvas></Viewbox>
        </Button>

        <Border Width="1" Height="16" Background="{DynamicResource SeparatorBrush}" Margin="6,0"/>

        <Button Classes="tool" Click="OnEditPost" ToolTip.Tip="Post — 고친 내용을 DB 로 보냄 (트랜잭션 안).&#x0a;확정은 상단 Commit(Ctrl+F5), 취소는 Rollback(Ctrl+F6)">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="M4,13 L10,19 L20,5" Stroke="{DynamicResource ExportGreenBrush}" StrokeThickness="3.2"
                  StrokeLineCap="Round" StrokeJoin="Round"/>
          </Canvas></Viewbox>
        </Button>
        <Button Classes="tool" Click="OnEditCancel" ToolTip.Tip="Cancel — 아직 Post 하지 않은 변경을 버리고 다시 조회.&#x0a;Post 한 것은 Rollback(Ctrl+F6) 으로 되돌린다">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource CancelRedBrush}" StrokeThickness="3.2"
                  StrokeLineCap="Round" StrokeJoin="Round"/>
          </Canvas></Viewbox>
        </Button>

        <Border Width="1" Height="16" Background="{DynamicResource SeparatorBrush}" Margin="6,0"/>

        <TextBlock Name="EditBarLabel" VerticalAlignment="Center" FontSize="12" Margin="4,0,0,0"/>
      </StackPanel>
    </Border>

    <Panel Grid.Row="1">
      <DataGrid Name="ResultGrid"
                IsReadOnly="True"
                SelectionMode="Extended"
                CanUserSortColumns="False"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                ClipboardCopyMode="IncludeHeader"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                RowHeight="22"/>
      <!-- Golden: 빈 결과 영역엔 "▸ 1  No Records" (그리드 위에 표시) -->
      <StackPanel Name="NoRecordsPanel" Orientation="Vertical"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="▸ 1" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                     Margin="6,2,8,0"/>
          <Border Background="{DynamicResource HeaderBgBrush}"
                  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="1" Padding="8,2">
            <TextBlock Text="No Records" FontSize="12"/>
          </Border>
        </StackPanel>
        <!-- 빈 상태 안내 (P2-5): 미접속이면 다음 행동을 알려준다 -->
        <TextBlock Name="EmptyHint" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                   Margin="6,10,0,0" IsVisible="False"
                   Text="Ctrl+L 로 접속한 뒤, SQL 을 쓰고 F9 로 실행하세요. 자동완성은 Ctrl+Space."/>
      </StackPanel>
      <!-- EXPLAIN (ANALYZE) 플랜 트리 (pgAdmin 그래픽 플랜의 트리 버전) -->
      <TreeView Name="PlanTree" IsVisible="False" Background="{DynamicResource ContentBgBrush}"
                FontFamily="Consolas,Menlo,Monaco,monospace" FontSize="12"/>
      <!-- Golden "Show Text" — 결과를 고정폭 텍스트로 (복사해 붙이기 좋게) -->
      <ScrollViewer Name="TextPane" IsVisible="False" Background="{DynamicResource ContentBgBrush}"
                    HorizontalScrollBarVisibility="Auto">
        <SelectableTextBlock Name="ResultText" Margin="10,8"
                             FontFamily="Consolas,Menlo,Monaco,monospace" FontSize="12.5"/>
      </ScrollViewer>
      <!-- Golden "Show Log" — 이 탭에서 실행한 문장의 시각·소요·결과 기록 -->
      <ScrollViewer Name="LogPane" IsVisible="False" Background="{DynamicResource ContentBgBrush}"
                    HorizontalScrollBarVisibility="Auto">
        <SelectableTextBlock Name="LogText" Margin="10,8"
                             FontFamily="Consolas,Menlo,Monaco,monospace" FontSize="12.5"/>
      </ScrollViewer>
      <ScrollViewer Name="ErrorPane" IsVisible="False" Background="{DynamicResource ContentBgBrush}">
        <SelectableTextBlock Name="ErrorText" Margin="12" TextWrapping="Wrap"
                             FontFamily="Consolas,Menlo,Monaco,monospace" FontSize="12.5"
                             Foreground="{DynamicResource ErrorRedBrush}"/>
      </ScrollViewer>
    </Panel>

    </Grid>

    <!-- 서버 메시지 (RAISE NOTICE/WARNING — pgAdmin Messages 탭, Golden output 창 대응) -->
    <Border Grid.Row="3" Name="MessagesPane" IsVisible="False"
            Background="{DynamicResource HeaderBgBrush}"
            BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Text="Messages" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="8,3,0,1"/>
        <ScrollViewer Grid.Row="1" Name="MessagesScroll" MaxHeight="110">
          <SelectableTextBlock Name="MessagesText" Margin="8,0,8,6" TextWrapping="Wrap"
                               FontFamily="Consolas,Menlo,Monaco,monospace" FontSize="12"/>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
