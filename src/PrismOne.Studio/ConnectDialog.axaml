<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:PrismOne.Db.Core"
        xmlns:local="using:PrismOne.Studio"
        x:Class="PrismOne.Studio.ConnectDialog"
        Icon="/Assets/icon.png"
        Title="Database Login - Aurum"
        Width="640" Height="700" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <!-- Golden 6 "Database Login" 재현:
       위 Login 그룹(동적 헤더 Login: user@host/db, Database 는 host[:port]/db 콤보) + 오른쪽 버튼,
       아래 Login List 그룹(그리드) + New/Edit/Delete/Filter/Import,Export -->
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,118" Margin="14">

    <!-- Login 그룹 -->
    <Border Grid.Row="0" Grid.Column="0"
            BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
            CornerRadius="2" Padding="14,14,14,10" Margin="0,8,12,0">
      <StackPanel>
        <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <Grid.Styles>
            <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="13.5"/></Style>
            <Style Selector="TextBox"><Setter Property="Margin" Value="0,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13.5"/></Style>
          </Grid.Styles>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:"/>
          <ComboBox  Grid.Row="0" Grid.Column="1" Name="DbTypeCombo"
                     MinHeight="32" FontSize="13.5" Margin="0,4"
                     HorizontalAlignment="Stretch"
                     SelectionChanged="OnDbTypeChanged"
                     ToolTip.Tip="접속할 데이터베이스 종류"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Name="UsernameLabel" Text="Username:"/>
          <TextBox   Grid.Row="1" Grid.Column="1" Name="UsernameBox" TextChanged="OnLoginFieldChanged"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Name="PasswordLabel" Text="Password:"/>
          <TextBox   Grid.Row="2" Grid.Column="1" Name="PasswordBox" PasswordChar="●"
                     TextChanged="OnPasswordChanged"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Name="DatabaseLabel" Text="Database:"/>
          <ComboBox  Grid.Row="3" Grid.Column="1" Name="DatabaseCombo" IsEditable="True"
                     MinHeight="32" FontSize="13.5" Margin="0,4"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="host[:port]/database"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="18" Margin="88,6,0,0">
          <CheckBox Name="ReadOnlyBox" Content="Read Only" FontSize="13"/>
          <TextBlock Text="비밀번호는 암호화되어 저장됩니다" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="0" Grid.Column="0" Name="LoginGroupHeader" Text=" Login " FontSize="13"
               Background="{DynamicResource ChromeBgBrush}"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,0,0,0"/>

    <!-- 오른쪽 세로 버튼 (Golden: Login / Close / Help / Options…) -->
    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8" Margin="0,16,0,0">
      <Button Name="ConnectButton" Content="Login" Classes="accent" IsDefault="True" MinHeight="34" FontSize="13.5"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnConnect"/>
      <Button Content="Close" MinHeight="32" FontSize="13" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnCancel" IsCancel="True"/>
      <Button Content="Help" MinHeight="32" FontSize="13" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="False"/>
      <Button Content="Options…" MinHeight="32" FontSize="13" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="False"/>
    </StackPanel>

    <!-- Login List 그룹 -->
    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="1"
            CornerRadius="2" Padding="10" Margin="0,20,0,0">
      <Grid RowDefinitions="Auto,Auto,*">
      <!-- Filter ▾ 로 여닫는 필터 행 — Golden: Username / Database / Category 로 필터 -->
      <Grid Grid.Row="0" Name="FilterRow" ColumnDefinitions="*,*,*" IsVisible="False" Margin="0,0,0,8">
        <Grid.Styles>
          <Style Selector="TextBox"><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12.5"/></Style>
        </Grid.Styles>
        <TextBox Grid.Column="0" Name="FilterUserBox" PlaceholderText="Filter Username"
                 Margin="0,0,6,0" TextChanged="OnFilterChanged"/>
        <TextBox Grid.Column="1" Name="FilterDbBox" PlaceholderText="Filter Database"
                 Margin="0,0,6,0" TextChanged="OnFilterChanged"/>
        <TextBox Grid.Column="2" Name="FilterCategoryBox" PlaceholderText="Filter Category"
                 TextChanged="OnFilterChanged"/>
      </Grid>
      <!-- DataGrid 대신 ListBox — 셀 개념이 없으니 셀 선택·셀 포커스 박스가
           애초에 생기지 않는다. 컬럼은 헤더 행과 항목 템플릿이 같은 폭을 공유한다.
           (DataGrid 로는 FocusAdorner·Focusable·BorderThickness 어느 것으로도
           클릭한 셀의 검은 사각형을 없애지 못했다) -->
      <Border Grid.Row="1" Padding="10,4" Margin="0,0,0,2"
              Background="{DynamicResource HeaderBgBrush}"
              BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="92,96,92,*,76,90">
          <Grid.Styles>
            <!-- Golden 처럼 헤더를 눌러 정렬. 버튼 티가 안 나게 배경을 지운다 -->
            <Style Selector="Button">
              <Setter Property="FontSize" Value="12.5"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <!-- 글자 폭이 아니라 컬럼 전체를 눌러 정렬할 수 있게 -->
              <Setter Property="HorizontalAlignment" Value="Stretch"/>
              <Setter Property="HorizontalContentAlignment" Value="Left"/>
              <Setter Property="Cursor" Value="Hand"/>
            </Style>
          </Grid.Styles>
          <Button Grid.Column="0" Name="SortName" Content="Name" Tag="Name" Click="OnSortHeader"/>
          <Button Grid.Column="1" Name="SortType" Content="Type" Tag="Type" Click="OnSortHeader"/>
          <Button Grid.Column="2" Name="SortUsername" Content="Username" Tag="Username" Click="OnSortHeader"/>
          <Button Grid.Column="3" Name="SortDatabase" Content="Database" Tag="Database" Click="OnSortHeader"/>
          <Button Grid.Column="4" Name="SortCategory" Content="Category" Tag="Category" Click="OnSortHeader"/>
          <Button Grid.Column="5" Name="SortComment" Content="Comment" Tag="Comment" Click="OnSortHeader"/>
        </Grid>
      </Border>
      <ListBox Grid.Row="2" Name="SavedGrid"
               SelectionMode="Single"
               Background="Transparent" BorderThickness="0" Padding="0"
               SelectionChanged="OnSavedSelected" DoubleTapped="OnSavedDoubleTapped">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="30"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:SavedConnection">
            <Grid ColumnDefinitions="92,96,92,*,76,90">
              <Grid.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="FontSize" Value="13"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>
              </Grid.Styles>
              <TextBlock Grid.Column="0" Text="{Binding Name}"/>
              <!-- 종류는 글자보다 색으로 먼저 알아보게 — 배지로 표시 -->
              <Border Grid.Column="1"
                      Background="{Binding Kind, Converter={x:Static local:DbKindBadge.Background}}"
                      CornerRadius="9" Padding="8,2" Margin="0,0,8,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding TypeLabel}" Foreground="White"
                           FontSize="11.5" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding Username}"/>
              <TextBlock Grid.Column="3" Text="{Binding DisplayDatabase}"/>
              <TextBlock Grid.Column="4" Text="{Binding Category}"/>
              <TextBlock Grid.Column="5" Text="{Binding Comment}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Grid.Column="0" Text=" Login List " FontSize="13"
               Background="{DynamicResource ChromeBgBrush}"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,12,0,0"/>

    <!-- 하단 버튼 (Golden: New Edit Delete | Filter Import/Export) -->
    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,10,0,0">
      <Grid.Styles>
        <Style Selector="Button"><Setter Property="MinHeight" Value="30"/><Setter Property="MinWidth" Value="72"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
      </Grid.Styles>
      <Button Grid.Column="0" Name="NewButton" Content="New" Click="OnNewLogin"/>
      <Button Grid.Column="1" Name="EditButton" Content="Edit" Click="OnEditSaved"/>
      <Button Grid.Column="2" Name="DeleteButton" Content="Delete" Click="OnDeleteSaved"/>
      <TextBlock Grid.Column="3" Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap"
                 FontSize="12.5" VerticalAlignment="Center" Margin="6,0" IsVisible="False"/>
      <Button Grid.Column="4" Name="FilterButton" Content="Filter ▾" Click="OnToggleFilter"/>
      <Button Grid.Column="5" Content="Import/Export ▾" IsEnabled="False" Margin="0"/>
    </Grid>

  </Grid>
</Window>
